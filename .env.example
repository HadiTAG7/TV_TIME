# ── Vercel deployment (set these in Vercel → Project → Settings → Environment Variables) ──

# Server-side only: the TMDB API key used by the /api/tmdb proxy function.
TMDB_API_KEY=

# Build flag: "1" routes all TMDB calls through /api/tmdb so no key ships
# in the client bundle. Leave unset for static hosts like GitHub Pages.
VITE_TMDB_PROXY=1

# ── Trakt (community comments on episodes) ──
# Server-side only: the Trakt Client ID used by the /api/trakt proxy function.
# Get one free at https://trakt.tv/oauth/applications (read-only; no user
# login needed). Without it the comments dialog shows an "unavailable" note
# and nothing else in the app is affected.
TRAKT_CLIENT_ID=

# ── Firebase (from Firebase console → Project settings → Your apps → Web app) ──
# All four must be present for Google sign-in + Firestore sync to activate;
# without them the app falls back to GitHub-Gist sync only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
